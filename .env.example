# ---------------------------------------------------------------- Supabase
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# ----------------------------------------------------------------- Mailgun
# Dashboard -> Sending -> Domain settings -> API keys
MAILGUN_API_KEY=your-mailgun-private-api-key
MAILGUN_DOMAIN=sandboxXXXXXXXX.mailgun.org
MAILGUN_FROM=Vellyshop <orders@sandboxXXXXXXXX.mailgun.org>
# Use https://api.eu.mailgun.net if the Mailgun account is on the EU region.
MAILGUN_BASE_URL=https://api.mailgun.net

# -------------------------------------------------------------------- Site
# The public origin. Locally this is http://localhost:3000; on Netlify set it
# to the deployed URL so the Google redirect comes back to the right place.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
